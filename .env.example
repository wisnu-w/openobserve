# ==============================================================================
# RanuObserve Engine / OpenObserve Environment Variables Example
# ==============================================================================

# --- Root User Credentials (Required on first startup) ---
ZO_ROOT_USER_EMAIL="admin@ranupod.com"
ZO_ROOT_USER_PASSWORD="Password123!"

# --- Server & Network ---
ZO_HTTP_PORT=5080
ZO_DATA_DIR="./data"
RUST_LOG="info"

# --- RanuPod Quota Limit Engine (Redis) ---
# Format URL: redis://[:password@]host[:port][/db]
ZO_REDIS_URL="redis://127.0.0.1:6379/0"
# Alternative format:
# REDIS_ADDR="127.0.0.1:6379"

# --- Storage & Engine Tweaks ---
ZO_LOCAL_MODE=true
ZO_MAX_FILE_SIZE_ON_DISK=32
ZO_FILE_PUSH_INTERVAL=10
# ZO_S3_BUCKET_NAME="zinc-dev"
